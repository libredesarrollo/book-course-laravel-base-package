{
    "$schema": "https://opencode.ai/config.json",
    "mcp": {
        "laravel-boost": {
            "type": "local",
            "enabled": true,
            "command": [
                "php",
                "artisan",
                "boost:mcp"
            ]
        },
        "laravel-posts": {
            "type": "local",
            "enabled": true,
            "command": [
                "php",
                "artisan",
                "mcp:start",
                "posts"
            ]
        },
        "laravel-posts-http": {
            "type": "remote",
            "enabled": false,
            "url": "http://larapackage.test/mcp/posts"
        }
    }
}